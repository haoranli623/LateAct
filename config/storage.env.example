# Copy this file to config/storage.env and adapt paths for your machine.
# config/storage.env is intentionally ignored because it is machine-specific.

export HF_HOME=/path/to/cache/huggingface
export HUGGINGFACE_HUB_CACHE=/path/to/cache/huggingface/hub
export TRANSFORMERS_CACHE=/path/to/cache/huggingface/transformers
export TORCH_HOME=/path/to/cache/torch

export LATEACT_UPSTREAM=/path/to/Matrix-Game
export LATEACT_MODEL_ROOT=/path/to/matrix-game-2
export LATEACT_ARTIFACT_ROOT=/path/to/lateact-artifacts
export LATEACT_MINWM_UPSTREAM=/path/to/minWM
export LATEACT_MINWM_MODEL_ROOT=/path/to/minwm-models

export PYTHONPATH="$PWD/src"
