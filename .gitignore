# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and editor/OS state
.venv/
venv/
env/
conda_envs/
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~

# Machine-specific environment files (publish only examples)
.env
.env.*
!.env.example
config/storage.env
*.pem
*.key
credentials*
secrets*

# Large experiment/model/data outputs live outside the recovery repository
artifacts/
generated_artifacts/
checkpoints/
models/
datasets/
data/
runs/
wandb/
.cache/
cache/
huggingface/
torch/
third_party/
